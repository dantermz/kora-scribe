# Meta Model API: Muse Voice Transcribe
MODEL_API_KEY=

# Muse Spark Open on Baseten: the verifier (and the baseline drafter in eval/)
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Muse Glimmer on your own Modal deployment (see README, "Running Muse Glimmer")
GLIMMER_BASE_URL=
GLIMMER_API_KEY=

# Drafter used by the pipeline. Leave empty to draft with Spark Open; to draft with Glimmer:
# DRAFT_BASE_URL=<same as GLIMMER_BASE_URL>
# DRAFT_API_KEY=<same as GLIMMER_API_KEY>
# DRAFT_MODEL=muse-glimmer
# DRAFT_REASONING=low
